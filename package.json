{
  "name": "open-latex-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "A local LaTeX editor and compiler with live PDF preview and local-LLM writing tools.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore './src/**' --ignore './dist/**' server/index.ts --dev",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "app": "vite build && tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "lucide-react": "^1.54.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
